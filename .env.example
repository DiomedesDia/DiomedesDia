# ID de cliente OAuth de Google (tipo "Aplicación web").
# Se obtiene en https://console.cloud.google.com/apis/credentials
# Ver el README para el paso a paso completo.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Clave de la API de Anthropic (Claude), para el asistente de calendario con IA.
# Se obtiene en https://console.anthropic.com/settings/keys
# OJO: sin el prefijo VITE_ a propósito — así nunca se incluye en el código del navegador,
# solo la lee el servidor del agente (server/index.js).
ANTHROPIC_API_KEY=sk-ant-...
