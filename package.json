{
  "name": "study-calendar-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,agent -c blue,green \"npm:dev:web\" \"npm:dev:agent\"",
    "dev:web": "vite",
    "dev:agent": "node server/index.js",
    "build": "tsc -b && vite build",
