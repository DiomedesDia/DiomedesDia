  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
